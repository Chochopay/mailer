# ─── Настройки отправки почты ───────────────────────────────────────────────
#
# Скопируй этот файл в .env и заполни своими данными:
#   Windows:      copy .env.example .env
#   Linux/macOS:  cp .env.example .env
#
# ─── Gmail (рекомендуется) ───────────────────────────────────────────────────
# 1. Включи двухфакторную аутентификацию: https://myaccount.google.com/security
# 2. Создай пароль приложения: Google Аккаунт → Безопасность → Пароли приложений
# 3. Вставь 16-значный пароль в EMAIL_HOST_PASSWORD (пробелы убирать не нужно)
#
DEFAULT_FROM_EMAIL=your@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_USE_TLS=true

# ─── Другой SMTP-провайдер ───────────────────────────────────────────────────
# Раскомментируй и замени значения под свой провайдер:
#
# DEFAULT_FROM_EMAIL=newsletter@yourdomain.com
# EMAIL_HOST=smtp.yourdomain.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=newsletter@yourdomain.com
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false   # используй вместо TLS только для порта 465
